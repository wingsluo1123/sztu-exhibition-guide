# 编译产物
build/
install/
log/

# Python
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
.pytest_cache/

# C++
*.o
*.so
*.a
*.exe

# IDE
.idea/
*.swp
*.swo
*~

# VSCode C/C++ 扩展生成的东西。settings.json 是共享配置，要入库；
# 下面这些不是：browse.vc.db* 是本机的二进制符号索引（几十 MB），
# c_cpp_properties.json 里是本机的绝对 include 路径，换台机器就不对了。
.vscode/browse.vc.db*
.vscode/c_cpp_properties.json
.vscode/ipch/

# 数据包：真机录的传感器数据，一个包几百 MB 到几 GB，不入库。
# 默认录到 ~/sztu_bags（见 tools/record_bag.sh），放项目里的也挡掉。
bags/
*.db3

# OS
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp
*.bak

# X2 URDF 模型：由 install_urdf.sh 从官方压缩包生成。
# STL 网格上百 MB，不入库。
src/sztu_description/meshes/*
!src/sztu_description/meshes/.gitkeep
src/sztu_description/urdf/*
!src/sztu_description/urdf/.gitkeep
