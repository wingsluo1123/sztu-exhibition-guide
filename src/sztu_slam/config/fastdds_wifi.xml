<?xml version="1.0" encoding="UTF-8" ?>
<!-- DDS transport for the robot host.

     Two lessons from 2026-10-28:

     1. The SHM segment was 64 MB. One chest cloud frame is 800 KB
        (25611 points x 32 B), so ~82 frames fill it. Once full, Fast DDS
        silently falls back to UDP for every topic on that participant.
        With UDP pinned to the Wi-Fi address, loopback traffic such as the
        vendor IMU stopped arriving: the adapter reported 208 scans but
        imu_samples 0. Raised to 256 MB.

     2. interfaceWhiteList hard-codes one address. When the hotspot
        renumbers the robot, or the Wi-Fi drops because the room is crowded,
        the UDP transport binds nothing and the participant fails to start.
        The symptom is processes alive near 20% CPU with every topic silent.
        UDP is now unpinned; SHM still carries the same-host point cloud
        path, which is what localisation actually depends on. -->

<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_large</transport_id>
        <type>SHM</type>
        <segment_size>268435456</segment_size>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp_wifi</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>8388608</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="sztu_wifi" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_large</transport_id>
          <transport_id>udp_wifi</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>