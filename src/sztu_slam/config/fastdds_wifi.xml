<?xml version="1.0" encoding="UTF-8" ?>
<!-- Wi-Fi-only DDS transport for the robot host.
     The robot has four NICs (sensor0, develop0, wifi0, ssh0); the stock
     profile leaves the UDPv4 transport unpinned, so Fast DDS advertises
     10.11.1.1 and the dev machine on 192.168.43.x never discovers it.
     Keep SHM for the large point clouds, pin UDP to the Wi-Fi address. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_large</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp_wifi</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>192.168.208.19</address>
        </interfaceWhiteList>
        <sendBufferSize>8388608</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="sztu_wifi" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_large</transport_id>
          <transport_id>udp_wifi</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>