<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sztu_interaction</name>
  <version>0.0.0</version>
  <description>SZTU interaction module for TTS, emotion, and gesture control</description>
  <maintainer email="robotics@sztu.edu.cn">agi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <depend>aimdk_msgs</depend>

  <!-- locomotion_controller 已转发到 sztu_navigation.locomotion -->
  <exec_depend>sztu_navigation</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
