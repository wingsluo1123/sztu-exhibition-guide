<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>map_wifi_udp</transport_id>
        <type>UDPv4</type>
        <maxMessageSize>65500</maxMessageSize>
        <sendBufferSize>8388608</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <publisher profile_name="sztu_map_wifi_writer" is_default_profile="true">
      <propertiesPolicy>
        <properties>
          <property>
            <name>fastdds.max_message_size</name>
            <value>1400</value>
          </property>
        </properties>
      </propertiesPolicy>
    </publisher>
    <participant profile_name="sztu_map_wifi" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>map_wifi_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
  <log>
    <use_default>false</use_default>
    <!-- Keep Fast DDS errors visible while hiding routine endpoint warnings. -->
    <verbosity>error</verbosity>
  </log>
</dds>
