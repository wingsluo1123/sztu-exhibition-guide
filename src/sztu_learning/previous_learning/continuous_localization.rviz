Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 52; 56
    Fixed Frame: learning_map
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Fixed reference map
    Enabled: true
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Current robot base path
    Enabled: true
    Color: 0; 210; 90
    Line Style: Lines
    Line Width: 0.03
    Pose Style: None
    Topic:
      Value: /learning/localization/robot_base_path
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Marker
    Name: Robot forward (+X of base_link, clears on loss)
    Enabled: true
    Topic:
      Value: /learning/localization/current_marker
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/PointCloud2
    Name: Current scan endpoints (flattened for display)
    Enabled: true
    Alpha: 0.8
    Style: Points
    Size (m): 0.025
    Color Transformer: FlatColor
    Color: 0; 170; 220
    Position Transformer: XYZ
    Decay Time: 0.3
    Use Fixed Frame: true
    Topic:
      Value: /learning/localization/endpoints
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 65
      X: -0.5
      Y: -0.5
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 920
