Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 52; 56
    Fixed Frame: learning_map
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Learning static map
    Enabled: true
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Update Topic:
      Value: /map_updates
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Use Timestamp: false
  - Class: rviz_default_plugins/Path
    Name: Saved trajectory (not live robot)
    Enabled: true
    Alpha: 1
    Color: 255; 90; 0
    Buffer Length: 1
    Line Style: Lines
    Line Width: 0.025
    Pose Style: None
    Topic:
      Value: /learning/map_trajectory
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 45
      X: -2.875
      Y: -4.15
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 920
  X: 20
  Y: 30
  Hide Left Dock: false
  Hide Right Dock: true
